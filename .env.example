SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
PORT=3000
# Google AI Studio (Gemini) — https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here
# Opsional, default: gemini-2.5-flash
GEMINI_MODEL=gemini-2.5-flash
# Auth JWT — ganti dengan string acak panjang & rahasia
JWT_SECRET=ganti-dengan-string-acak-panjang
# Aktifkan proteksi endpoint (set true SETELAH frontend & backend terdeploy)
AUTH_ENFORCED=false
# Push notification (FCM) — isi JSON service account Firebase (1 baris). Kosongkan untuk nonaktif.
FIREBASE_SERVICE_ACCOUNT=
